 "frags": [
  {
   "line": 1,
   "text": "Ghar khareedna ek smart decision hai\u2026",
   "s": 0.0,
   "e": 1.733
  },
  {
   "line": 1,
   "text": "ya rent pe lena?",
   "s": 1.733,
   "e": 2.404
  },
  {
   "line": 1,
   "text": "20 saal ke hisaab se dekhoge, toh chaunk jaoge!",
   "s": 2.595,
   "e": 4.8
  },
  {
   "line": 2,
   "text": "Bunty ek \u20b980 lakh ka flat leta hai,",
   "s": 4.952,
   "e": 7.003
  },
  {
   "line": 2,
   "text": "jisme \u20b916 lakh down payment,",
   "s": 7.003,
   "e": 8.711
  },
  {
   "line": 2,
   "text": "upar se \u20b96 lakh stamp duty aur registration.",
   "s": 8.711,
   "e": 11.616
  },
  {
   "line": 2,
   "text": "So total \u20b922 lakh.",
   "s": 11.9,
   "e": 12.386
  },
  {
   "line": 3,
   "text": "Phir aati hai har mahine \u20b953,000 ki EMI,",
   "s": 12.607,
   "e": 15.273
  },
  {
   "line": 3,
   "text": "20 saal ke liye.",
   "s": 15.273,
   "e": 16.339
  },
  {
   "line": 3,
   "text": "Matlab \u20b964 lakh interest seedha bank ko!",
   "s": 16.511,
   "e": 18.79
  },
  {
   "line": 4,
   "text": "Momo wahi flat \u20b920,000 rent pe leta hai,",
   "s": 18.79,
   "e": 20.689
  },
  {
   "line": 4,
   "text": "aur bacha hua saara paisa har mahine invest karta hai.",
   "s": 20.857,
   "e": 24.207
  },
  {
   "line": 5,
   "text": "20 saal baad: Bunty ka flat lagbhag \u20b93 crore ka.",
   "s": 24.207,
   "e": 26.719
  },
  {
   "line": 5,
   "text": "Momo ka investment, 12% pe, lagbhag \u20b95 crore!",
   "s": 26.873,
   "e": 30.38
  },
  {
   "line": 6,
   "text": "Momo Bunty se aage tabhi nikla jab usne apni SIP kabhi miss nahi ki.",
   "s": 30.535,
   "e": 34.631
  },
  {
   "line": 6,
   "text": "Market upar ho ya neeche, long term mein market upar hi gaya hai,",
   "s": 34.631,
   "e": 38.499
  },
  {
   "line": 6,
   "text": "isliye SIP mein discipline sabse zaroori hai.",
   "s": 38.499,
   "e": 41.381
  },
  {
   "line": 7,
   "text": "Matlab rent hamesha sahi nahi hai:",
   "s": 41.381,
   "e": 43.505
  },
  {
   "line": 7,
   "text": "agar discipline nahi, toh ghar hi behtar hai.",
   "s": 43.764,
   "e": 48.528
  }
 ],
